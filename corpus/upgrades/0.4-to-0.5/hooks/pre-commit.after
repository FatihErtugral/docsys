#!/usr/bin/env bash
set -uo pipefail

# --- docsys documentation gate ---------------------------------------------
# docsys-template: 0.18.0
# Hard gate: the lint errors and dangling references a commit adds stop it; those it inherits are named.
# One-off skip: DOCSYS_SKIP=1 git commit ... (under commit_policy: require it leaves a debt item)
docsys_gate_exit=1
# a branch whose tree declares an older spec is not scoped: it only warns (D-136)
case "$(sed -n 's/^spec:[[:space:]]*//p' "docs/.docmeta.yml" 2>/dev/null | tr -d "\"'[:space:]")" in
  docsys/0.[0-5]) docsys_gate_exit=0 ;;
esac
docsys_install="bash docs/.docsys-install"
[ -f "docs/.docsys-install" ] || docsys_install="cargo install docsys --version $(head -n 1 "docs/.docsys-version" 2>/dev/null) --locked"
if [ -z "${DOCSYS_SKIP:-}" ] && command -v docsys >/dev/null; then
  docsys_pin=$(head -n 1 "docs/.docsys-version" 2>/dev/null)
  if [ -n "$docsys_pin" ] && ! docsys --version >/dev/null 2>&1; then
    echo "docsys: this tree pins docsys $docsys_pin; install: $docsys_install" >&2
    [ "$docsys_gate_exit" -eq 0 ] || exit 1
  elif ! docsys gate --repo . --root docs && [ "$docsys_gate_exit" -ne 0 ]; then
    exit 1
  fi
elif [ -n "${DOCSYS_SKIP:-}" ] && command -v docsys >/dev/null; then
  docsys gate --repo . --root docs --skipped >/dev/null || echo "docsys: this skipped commit is not recorded — the line above says why" >&2
elif [ -z "${DOCSYS_SKIP:-}" ]; then
  echo "docsys: not installed, so this commit is not checked; install the version this tree pins: $docsys_install" >&2
fi
# --- end of the docsys gate ---
